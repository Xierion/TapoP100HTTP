[Unit]
Description=Tapo P100 HTTP bridge for Moonraker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi # Update for user
Group=pi # Update for user
WorkingDirectory=/home/pi/tapo_http_bridge # Update for user
ExecStart=/home/pi/tapo_http_bridge/venv/bin/python3 /home/pi/tapo_http_bridge/app.py # Update for user
Restart=on-failure
RestartSec=5

# Config file holds your Tapo account password - keep it locked down.
UMask=0077

[Install]
WantedBy=multi-user.target
